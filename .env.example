# -----------------------------------------------------------------------------
# Supabase
# Find these in your Supabase project: Project Settings → API Keys.
# For local development, `supabase start` prints them.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. Server-only — never expose it.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public URL of this app, used in invite and password reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# self_hosted: one organization, first user becomes owner, everyone else joins by invite.
# hosted: multiple organizations on one instance (for running it as a service).
DEPLOYMENT_MODE=self_hosted
# Optional: /setup asks for this before creating the owner account, so a fresh
# deployment can't be claimed by someone else first. Use a long random string.
SETUP_TOKEN=
# Optional: how many reverse proxies append to X-Forwarded-For (default 1).
TRUSTED_PROXY_HOPS=

# -----------------------------------------------------------------------------
# Email (optional, recommended)
# Used for invitations and password resets. Without it, admins get copyable
# invite links and users can't reset their own password. See docs/email-setup.md.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to "true" for implicit TLS (usually port 465). Defaults to true only on port 465.
SMTP_SECURE=
SMTP_FROM="Lead Tracker <no-reply@your-domain.com>"

# -----------------------------------------------------------------------------
# Voice assistant (optional)
# A mic in the corner of the app for following up on leads, creating new ones
# and asking about the pipeline by voice. Needs an ElevenLabs key for speech
# plus one LLM key; it stays hidden until both are set. See docs/voice.md.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Optional: any voice from your ElevenLabs library (defaults to "George").
ELEVENLABS_VOICE_ID=
# Set one of these. If several are set, VOICE_LLM_PROVIDER picks
# (anthropic, openai or google); otherwise the first one listed wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOICE_LLM_PROVIDER=
# Optional model override, e.g. claude-haiku-5-5 for faster replies.
# Defaults: claude-opus-5-5, gpt-5.5, gemini-3.5-flash.
VOICE_LLM_MODEL=
